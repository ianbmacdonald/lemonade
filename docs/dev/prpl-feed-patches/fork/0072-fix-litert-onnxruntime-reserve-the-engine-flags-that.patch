 // `classifier` condition type (issue #2592) on the CPU EP. The subprocess is a
diff --git a/src/cpp/server/backends/litert/litert_server.cpp b/src/cpp/server/backends/litert/litert_server.cpp
index d61ba8934..301b07f65 100644
--- a/src/cpp/server/backends/litert/litert_server.cpp
+++ b/src/cpp/server/backends/litert/litert_server.cpp
@@ -12,7 +12,6 @@
 #include <algorithm>
 #include <filesystem>
 #include <optional>
-#include <set>
 #include <string>
 #include <vector>
 #include <lemon/utils/aixlog.hpp>
@@ -88,12 +87,8 @@ void LiteRtServer::load(const std::string& model_name,
         "--port", std::to_string(port_),
