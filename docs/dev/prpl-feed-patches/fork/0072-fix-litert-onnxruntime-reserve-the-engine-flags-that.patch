From a256a906cf08847e99c6c81b17b9a762875428ce Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 17:55:12 -0400
Subject: [PATCH 072/109] fix(litert,onnxruntime): reserve the engine flags
 that bind or write files

litert_args and onnxruntime_args come from the /load request body.
litert-lm-server takes --cache-dir, which sets where it writes the XNNPACK
weight cache, and ort-server takes --host, which would publish the engine
on the LAN without lemond's API key. Both are now refused, through a
reserved_custom_arg_flags() in each descriptor header as tflite and
executorch already do, and EngineReservedArgsTest covers all four engines.

Assisted-by: claude:opus-5.5
---
 .../include/lemon/backends/litert/litert.h    | 14 +++++++++++
 .../lemon/backends/onnxruntime/onnxruntime.h  | 11 +++++++++
 .../server/backends/litert/litert_server.cpp  |  7 +-----
 .../onnxruntime/onnxruntime_server.cpp        |  5 ++--
 test/cpp/test_engine_reserved_args.cpp        | 24 +++++++++++++------
 5 files changed, 45 insertions(+), 16 deletions(-)

diff --git a/src/cpp/include/lemon/backends/litert/litert.h b/src/cpp/include/lemon/backends/litert/litert.h
index f228cf35c..cff7e611b 100644
--- a/src/cpp/include/lemon/backends/litert/litert.h
+++ b/src/cpp/include/lemon/backends/litert/litert.h
@@ -2,10 +2,24 @@
 
 #include "lemon/backends/backend_descriptor.h"
 
+#include <set>
+#include <string>
+
 namespace lemon {
 namespace backends {
 namespace litert {
 
+// Arguments litert_args must not carry. litert_args comes from the /load
+// request body: --host would publish the engine on the LAN without lemond's
+// API key, and --cache-dir would make the engine write its weight cache at a
+// path the caller chooses.
+inline const std::set<std::string>& reserved_custom_arg_flags() {
+    static const std::set<std::string> flags = {
+        "--model", "--port", "--host", "--cache-dir",
+    };
+    return flags;
+}
+
 // The LiteRT backend descriptor (plain data). Header-only `inline const` so it
