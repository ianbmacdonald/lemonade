+bool parse_u64(const std::string& text, uint64_t& out) {
+    if (text.empty() || !std::all_of(text.begin(), text.end(),
+                                     [](unsigned char c) { return std::isdigit(c) != 0; })) {
+        return false;
+    }
+    try {
