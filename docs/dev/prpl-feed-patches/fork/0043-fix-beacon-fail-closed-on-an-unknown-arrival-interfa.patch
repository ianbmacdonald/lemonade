 bool beacon_arrival_accepted(bool allowlist_active, unsigned ifindex,
                              const std::vector<unsigned>& listened_ifindexes) {
-    (void)allowlist_active;
-    if (ifindex == 0) return true;
+    if (ifindex == 0) return !allowlist_active;
