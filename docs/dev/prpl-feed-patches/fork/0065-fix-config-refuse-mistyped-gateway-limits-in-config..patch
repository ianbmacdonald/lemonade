From c4935db384184b6be0aef805cd4fa89fe2e9da52 Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 15:00:10 -0400
Subject: [PATCH 65/91] fix(config): refuse mistyped gateway limits in
 config.json

A request_receive_timeout, max_connections_per_client or
max_request_body_mb that is not an integer, such as "30", was read back
silently as the default, which switches the limit off. Startup now
refuses it, as it already does for a mistyped beacon setting. A value of
the right type that is out of range is still clamped or falls back as
before.

Assisted-by: claude:opus-5.5
---
 src/cpp/server/runtime_config.cpp       |  6 ++++++
 test/cpp/test_config_gateway_limits.cpp | 21 +++++++++++++++++----
 2 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/src/cpp/server/runtime_config.cpp b/src/cpp/server/runtime_config.cpp
index 616827fa3..be794d2fa 100644
--- a/src/cpp/server/runtime_config.cpp
+++ b/src/cpp/server/runtime_config.cpp
@@ -311,6 +311,12 @@ RuntimeConfig::RuntimeConfig(const json& config)
     if (config_.contains("beacon_trusted_relays")) {
         parse_beacon_trusted_relays(config_["beacon_trusted_relays"]);
     }
+    // These read back as "off" when mistyped, which must not pass silently.
+    for (const char* key : {"max_request_body_mb", "request_receive_timeout", "max_connections_per_client"}) {
+        if (config_.contains(key) && !config_[key].is_number_integer()) {
+            throw std::invalid_argument(std::string("'") + key + "' must be an integer");
+        }
+    }
     // Migrate legacy no_broadcast if present
     if (config_.contains("no_broadcast")) {
         if (!config_["no_broadcast"].is_boolean()) {
diff --git a/test/cpp/test_config_gateway_limits.cpp b/test/cpp/test_config_gateway_limits.cpp
index 8555a5620..b683d2ffe 100644
--- a/test/cpp/test_config_gateway_limits.cpp
+++ b/test/cpp/test_config_gateway_limits.cpp
@@ -13,6 +13,15 @@ using lemon::RuntimeConfig;
 using test_helpers::check;
 using test_helpers::report_results;
 
+static bool construct_throws(const json& config) {
+    try {
+        RuntimeConfig{config};
+        return false;
+    } catch (const std::invalid_argument&) {
+        return true;
+    }
+}
+
 static bool set_throws(const json& changes) {
     try {
         RuntimeConfig(json::object()).set(changes);
@@ -37,12 +46,16 @@ int main() {
     check(gateway.request_receive_timeout() == 30, "receive timeout read from config");
     check(gateway.max_connections_per_client() == 8, "per-client cap read from config");
 
-    const RuntimeConfig bad(json{{"max_request_body_mb", 0},
-                                 {"request_receive_timeout", -1},
-                                 {"max_connections_per_client", "8"}});
+    const RuntimeConfig bad(json{{"max_request_body_mb", 0}, {"request_receive_timeout", -1}});
     check(bad.max_request_body_mb() == 100, "out-of-range body limit falls back to the default");
     check(bad.request_receive_timeout() == 0, "negative timeout falls back to off");
-    check(bad.max_connections_per_client() == 0, "non-integer cap falls back to off");
+
+    check(construct_throws({{"max_connections_per_client", "8"}}),
+          "a string cap in config.json is refused, not read as off");
+    check(construct_throws({{"request_receive_timeout", "30"}}),
+          "a string timeout in config.json is refused, not read as off");
+    check(construct_throws({{"max_request_body_mb", 32.5}}),
+          "a fractional body limit in config.json is refused");
 
     const RuntimeConfig too_big(json{{"max_request_body_mb", 100000},
                                      {"request_receive_timeout", 7200},
-- 
