+        {"an empty labels_file", R"({"task":"image-classification","labels_file":""})"},
+        {"a non-string labels_file", R"({"task":"image-classification","labels_file":5})"},
+        {"a missing labels file", R"({"task":"image-classification","labels_file":"absent.txt"})"},
+    };
