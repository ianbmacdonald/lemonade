+        const fs::path dir = base / ("bad_labels_" + std::to_string(n++));
+        make_text_with_manifest(dir, graph, manifest);
+        check_unservable(recipe + ": image manifest with " + name + " and text files", dir,
+                         graphs, ops);
+    }
+
