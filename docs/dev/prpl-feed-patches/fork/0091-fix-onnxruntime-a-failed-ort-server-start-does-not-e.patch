@@ -826,6 +829,55 @@ class ImageClassifyTests(ServerTestBase):
         )
         self._assert_reference(response, 1)
 
+    def test_515_broken_ort_model_keeps_resident_models(self):
+        if not _opts.fake_ort:
+            self.skipTest("needs --fake-ort")
+        self._require_model()
+        failed = os.path.join(_opts.fake_state_dir, "failed-starts.log")
+        self._assert_reference(
+            self._post_form(
+                {"image": ("g.jpg", self._fixture(), "image/jpeg")},
+                data={"model": MODEL, "top_k": "1"},
+            ),
+            1,
+        )
+        name = "user.B194-Broken-Ort"
+        dest = os.path.join(_opts.hf_cache, "models--" + name[len("user.") :])
+        if os.path.isdir(dest):
+            shutil.rmtree(dest)
+        os.makedirs(dest)
+        for file_name in (
+            "model.onnx",
+            "tokenizer.json",
+            "config.json",
+            "FAKE_FAIL_START",
+        ):
+            with open(os.path.join(dest, file_name), "w", encoding="utf-8") as f:
+                f.write("{}")
+        response = requests.post(
+            f"{self.base_url}/pull",
+            json={
+                "model_name": name,
+                "recipe": "onnxruntime",
+                "labels": ["classification"],
+                "local_import": True,
+            },
+            timeout=TIMEOUT_DEFAULT,
+        )
+        self.assertEqual(response.status_code, 200, response.text[:500])
+        failed_before = _line_count(failed)
+        response = requests.post(
+            f"{self.base_url}/load", json={"model_name": name}, timeout=TIMEOUT_DEFAULT
+        )
+        self.assertGreaterEqual(response.status_code, 400, response.text[:500])
+        # One start and one relaunch to capture its stderr; evicting the other
+        # models and loading again cannot fix a CPU engine that refused its model.
+        self.assertEqual(_line_count(failed) - failed_before, 2)
+        health = requests.get(f"{self.base_url}/health", timeout=TIMEOUT_DEFAULT).json()
+        # /health lists public names, without the user. prefix.
+        loaded = [m["model_name"] for m in health["all_models_loaded"]]
+        self.assertIn(MODEL[len("user.") :], loaded, "the image model was evicted")
+
     def test_513_repeated_text_crashes_pause_the_model(self):
         self._require_model()
         self._require_text_model()
diff --git a/test/utils/fake_tflite_server.py b/test/utils/fake_tflite_server.py
index 9c5e0f9a6..2c84ebd22 100644
--- a/test/utils/fake_tflite_server.py
+++ b/test/utils/fake_tflite_server.py
@@ -23,6 +23,9 @@ containing POISON_TEXT, never answers text containing HANG_TEXT and stops
 answering GET /health meanwhile, as a single-threaded engine would, and
 otherwise returns fixed label scores.
 
+A model dir containing FAKE_FAIL_START makes the server exit 3 at startup,
+as an engine that refuses its model does; it also stands in for ort-server.
+
 When FAKE_TFLITE_STATE_DIR is set, each start, crash and hang appends a line to
 starts.log / crashes.log / hangs.log there, and each start writes its arguments as a JSON
 list to args.log.
@@ -190,6 +193,9 @@ def main():
     def has(name):
         return os.path.exists(os.path.join(args.model_path, name))
 
+    if has("FAKE_FAIL_START"):
+        _log("failed-starts.log", str(os.getpid()))
+        sys.exit(3)
     if has("manifest.json"):
         task = "image-classification"
     elif has("tokenizer.json") and has("config.json"):
