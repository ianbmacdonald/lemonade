From e130ddd50d221dfa44b2a09887a2fd99ca58ab1d Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 15:00:10 -0400
Subject: [PATCH 64/91] fix(beacon): parse a pinned source's new datagrams only
 on a global token

A pinned source skipped the global bucket and spent its own token only on
a valid beacon. Junk sent with its source IP took a global token after the
parse and ignored the result, so once the global bucket was empty the junk
was still parsed at whatever rate the sender chose. Charging the junk to the
source's own bucket would bound the parsing, but it would also let the junk
starve that peer's real refreshes.

Each row now keeps the datagram that last made or refreshed it. A pinned
source that repeats that datagram still skips the global bucket. Anything
else it sends needs a global token before it is parsed.

Assisted-by: claude:opus-5.5
---
 src/cpp/include/lemon/utils/beacon_listener.h |  3 ++
 src/cpp/server/utils/beacon_listener.cpp      | 33 ++++++++++++++-----
 test/cpp/test_beacon_peer_table.cpp           | 14 ++++++++
 3 files changed, 41 insertions(+), 9 deletions(-)

diff --git a/src/cpp/include/lemon/utils/beacon_listener.h b/src/cpp/include/lemon/utils/beacon_listener.h
index 9e6eabf4c..4d64324f3 100644
--- a/src/cpp/include/lemon/utils/beacon_listener.h
+++ b/src/cpp/include/lemon/utils/beacon_listener.h
@@ -88,6 +88,8 @@ struct HeardHost {
     uint32_t url_host = 0;
     // Datagram source when the host was heard through a trusted relay, else 0.
     uint32_t via = 0;
+    // The datagram that last created or refreshed the row.
+    std::string payload;
     std::chrono::system_clock::time_point first_seen_wall;
     std::chrono::system_clock::time_point last_seen_wall;
     std::chrono::steady_clock::time_point last_seen;
@@ -134,6 +136,7 @@ private:
     const BeaconTrustedRelay* relay_for_locked(uint32_t src_ip) const;
     bool take_global_token_locked(std::chrono::steady_clock::time_point now);
     bool is_pinned_locked(uint32_t src_ip) const;
+    bool is_repeat_locked(uint32_t src_ip, const char* buf, std::size_t len) const;
     void expire_locked(std::chrono::steady_clock::time_point now);
     IngestResult record_locked(IngestResult result);
 
diff --git a/src/cpp/server/utils/beacon_listener.cpp b/src/cpp/server/utils/beacon_listener.cpp
index adb421b1d..0b72d9e48 100644
--- a/src/cpp/server/utils/beacon_listener.cpp
+++ b/src/cpp/server/utils/beacon_listener.cpp
@@ -328,6 +328,17 @@ bool BeaconPeerTable::is_pinned_locked(uint32_t src_ip) const {
     return false;
 }
 
+bool BeaconPeerTable::is_repeat_locked(uint32_t src_ip, const char* buf, std::size_t len) const {
+    if (buf == nullptr) return false;
+    for (const auto& [url, row] : rows_) {
+        if (row.source_ip_host_order == src_ip && row.payload.size() == len &&
+            std::memcmp(row.payload.data(), buf, len) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
 BeaconPeerTable::SourceState& BeaconPeerTable::source_state_locked(uint32_t src_ip,
                                                                    steady_clock::time_point now) {
     auto it = sources_.find(src_ip);
@@ -400,20 +411,22 @@ IngestResult BeaconPeerTable::ingest(const char* buf, std::size_t len, bool trun
     if (!utils::is_rfc1918_ipv4(src_ip)) return record_locked(IngestResult::BadSource);
     expire_locked(now);
 
-    // Pinned sources (those owning a live row) skip the global bucket so a
-    // flood from other addresses cannot starve refreshes from known peers.
-    // Their per-source token is only spent on a structurally valid beacon:
-    // junk forged with a known peer's source IP must not drain the budget of
-    // that peer's real refreshes, so it is charged to the global bucket.
+    // A pinned source (one owning a live row) repeating the datagram that
+    // made or last refreshed its row skips the global bucket, so a flood from
+    // other addresses cannot starve refreshes from known peers. Anything else
+    // it sends may be junk forged with its source IP: that pays the global
+    // bucket before it is parsed, and never drains the peer's own budget.
     if (is_pinned_locked(src_ip)) {
         if (source_state_locked(src_ip, now).bucket.tokens < 1.0) {
             return record_locked(IngestResult::RateLimited);
         }
+        const bool repeat = is_repeat_locked(src_ip, buf, len);
+        if (!repeat && !take_global_token_locked(now)) {
+            return record_locked(IngestResult::RateLimited);
+        }
         IngestResult result = ingest_admitted_locked(buf, len, truncated, src_ip, now);
-        if (result == IngestResult::BadPayload || result == IngestResult::UrlMismatch ||
-            result == IngestResult::RelayHostRefused) {
-            take_global_token_locked(now);
-        } else {
+        if (repeat || (result != IngestResult::BadPayload && result != IngestResult::UrlMismatch &&
+                       result != IngestResult::RelayHostRefused)) {
             auto it = sources_.find(src_ip);
             if (it != sources_.end()) it->second.bucket.tokens -= 1.0;
         }
@@ -497,6 +510,7 @@ IngestResult BeaconPeerTable::ingest_admitted_locked(const char* buf, std::size_
         row.source_ip_host_order = src_ip;
         row.url_host = url_host;
         row.via = via;
+        row.payload.assign(buf, len);
         row.last_seen = now;
         row.last_seen_wall = wall;
         return record_locked(relay != nullptr ? IngestResult::RelayedRefreshed : IngestResult::Refreshed);
@@ -535,6 +549,7 @@ IngestResult BeaconPeerTable::ingest_admitted_locked(const char* buf, std::size_
     row.url_host = url_host;
     row.via = via;
     row.instance_id = instance_id;
+    row.payload.assign(buf, len);
     row.first_seen_wall = wall;
     row.last_seen_wall = wall;
     row.last_seen = now;
diff --git a/test/cpp/test_beacon_peer_table.cpp b/test/cpp/test_beacon_peer_table.cpp
index cce0a37b7..d99fc8a4a 100644
--- a/test/cpp/test_beacon_peer_table.cpp
+++ b/test/cpp/test_beacon_peer_table.cpp
@@ -395,6 +395,19 @@ void test_pinned_junk_flood(Clock::time_point t0) {
     check(t.size() == 1, "pinned junk: legitimate row survives the flood");
 }
 
+void test_pinned_junk_parse_bound(Clock::time_point t0) {
+    BeaconPeerTable t;
+    uint32_t peer = ip(192, 168, 1, 40);
+    std::string good = beacon(url_for(peer), "legit");
+    check(feed(t, good, peer, t0) == IngestResult::Accepted, "pinned junk bound: peer accepted");
+    const auto now = t0 + std::chrono::milliseconds(1);
+    for (int i = 0; i < 5000; ++i) feed(t, "not json at all", peer, now);
+    check(t.stat(IngestResult::BadPayload) <= static_cast<uint64_t>(lemon::kGlobalBurst),
+          "pinned junk bound: junk stops being parsed once the global bucket is spent");
+    check(feed(t, good, peer, now) == IngestResult::Refreshed,
+          "pinned junk bound: the peer's real refresh still gets through");
+}
+
 void test_single_source_flood(Clock::time_point t0) {
     BeaconPeerTable t;
     uint32_t noisy = ip(10, 0, 0, 7);
@@ -574,6 +587,7 @@ int main() {
     test_rate_limit_per_source(t0);
     test_flood_survival(t0);
     test_pinned_junk_flood(t0);
+    test_pinned_junk_parse_bound(t0);
     test_single_source_flood(t0);
     test_trusted_relay(t0);
 
