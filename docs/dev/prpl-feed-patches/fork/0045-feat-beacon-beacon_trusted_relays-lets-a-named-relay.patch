+namespace {
+bool relay_allows(const BeaconTrustedRelay& relay, uint32_t url_host) {
+    if (!utils::is_rfc1918_ipv4(url_host)) return false;
+    return std::any_of(relay.allow_hosts.begin(), relay.allow_hosts.end(),
