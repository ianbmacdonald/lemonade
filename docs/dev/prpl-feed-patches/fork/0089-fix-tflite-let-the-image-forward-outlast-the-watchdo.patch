From 008c3a44d420e5b4681fe628147a82d5e3fb679e Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sun, 1 Nov 2026 15:14:04 -0500
Subject: [PATCH 89/97] fix(tflite): let the image forward outlast the watchdog
 kill

The image classify forward timed out at 60 s, before the watchdog's kill
(about 105 s with the defaults). A hung engine then failed every image
request with a 500 network error and was never reset. It now waits
120 s, like the text path, so the watchdog stops the engine and the
request gets 504 backend_unresponsive_on_input.

Assisted-by: claude:opus-5.5
---
 .../server/backends/tflite/tflite_server.cpp  |  2 +-
 test/server_image_classify.py                 | 26 +++++++++++++++++++
 test/utils/fake_tflite_server.py              |  7 +++++
 3 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/cpp/server/backends/tflite/tflite_server.cpp b/src/cpp/server/backends/tflite/tflite_server.cpp
index 376194921..623f37102 100644
--- a/src/cpp/server/backends/tflite/tflite_server.cpp
+++ b/src/cpp/server/backends/tflite/tflite_server.cpp
@@ -361,7 +361,7 @@ json TfliteServer::classify_image(const json& params, std::string image_bytes) {
     if (mime.empty()) mime = "application/octet-stream";
     fields.push_back({"image", std::move(image_bytes), "image", std::move(mime)});
     fields.push_back({"top_k", std::to_string(top_k), "", ""});
-    return normalize_backend_error(forward_multipart_request("/classify/image", fields, 60));
+    return normalize_backend_error(forward_multipart_request("/classify/image", fields, 120));
 }
 
 }  // namespace backends
diff --git a/test/server_image_classify.py b/test/server_image_classify.py
index 081e03450..6c2871951 100644
--- a/test/server_image_classify.py
+++ b/test/server_image_classify.py
@@ -71,6 +71,7 @@ REFERENCE_SCORE = 0.803491
 REFERENCE_TOL = 0.02
 POISON = b"B169-POISON-IMAGE"
 SLOW = b"B169-SLOW-IMAGE"
+HANG_IMAGE = b"B194-HANG-IMAGE"
 
 _opts = argparse.Namespace(
     image_model_dir=None,
@@ -800,6 +801,31 @@ class ImageClassifyTests(ServerTestBase):
         # Three slow inputs are not three crashes, so the model is not paused.
         self._assert_status(self._classify_text("hello"), 200, "after three hangs")
 
+    def test_512d_hanging_image_resets_the_backend(self):
+        # Under the default watchdog (about 105 s to a kill) the image forward
+        # must outlast the kill, or a hung engine is never reset.
+        if _opts.short_watchdog:
+            self.skipTest("needs the default watchdog")
+        hangs = os.path.join(_opts.fake_state_dir, "hangs.log")
+        self._post_form(
+            {"image": ("g.jpg", self._fixture(), "image/jpeg")}, {"model": MODEL}
+        )
+        hangs_before = _line_count(hangs)
+        response = self._post_form(
+            {"image": ("hang.jpg", _jpeg_like(HANG_IMAGE), "image/jpeg")},
+            data={"model": MODEL},
+        )
+        self._assert_status(response, 504, "hanging image")
+        self.assertEqual(
+            response.json()["error"]["code"], "backend_unresponsive_on_input"
+        )
+        self.assertEqual(_line_count(hangs) - hangs_before, 1)
+        response = self._post_form(
+            {"image": ("g.jpg", self._fixture(), "image/jpeg")},
+            data={"model": MODEL, "top_k": "1"},
+        )
+        self._assert_reference(response, 1)
+
     def test_513_repeated_text_crashes_pause_the_model(self):
         self._require_model()
         self._require_text_model()
