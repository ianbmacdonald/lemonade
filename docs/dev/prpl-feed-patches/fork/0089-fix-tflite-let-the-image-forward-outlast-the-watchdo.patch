 HANG_TEXT = "B194-HANG-TEXT"
 SLOW_SECONDS = 4
@@ -148,6 +151,10 @@ def make_handler(args, task):
                 _crash()
             if SLOW in image:
                 time.sleep(SLOW_SECONDS)
+            if HANG_IMAGE in image:
