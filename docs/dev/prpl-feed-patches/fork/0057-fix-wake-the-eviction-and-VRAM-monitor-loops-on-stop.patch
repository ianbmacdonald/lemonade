From c2bf329d743668fed6c35ba72cad1ded84881620 Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 03:05:43 -0400
Subject: [PATCH 57/97] fix: wake the eviction and VRAM monitor loops on stop

Both loops slept their whole interval (5 s and 2 s) before seeing a stop, so
lemond took about 6 s to exit on SIGTERM with nothing loaded. A condition
variable wait ends the sleep as soon as stop() is called, which matters when
lemond is PID 1 in a container.

Assisted-by: claude:opus-5.5
---
 src/cpp/include/lemon/eviction_engine.h     | 4 ++++
 src/cpp/include/lemon/global_vram_monitor.h | 4 ++++
 src/cpp/server/eviction_engine.cpp          | 9 +++++++--
 src/cpp/server/global_vram_monitor.cpp      | 9 +++++++--
 4 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/src/cpp/include/lemon/eviction_engine.h b/src/cpp/include/lemon/eviction_engine.h
index 250e1c3ab..3254cc16b 100644
--- a/src/cpp/include/lemon/eviction_engine.h
+++ b/src/cpp/include/lemon/eviction_engine.h
@@ -3,6 +3,7 @@
 #include <vector>
 #include <thread>
 #include <atomic>
+#include <condition_variable>
 #include <mutex>
 
 namespace lemon {
@@ -32,6 +33,9 @@ private:
     std::atomic<bool> running_;
     int interval_ms_;
     std::thread engine_thread_;
+    // stop() wakes the loop, so a shutdown does not wait out the interval.
+    std::mutex wake_mutex_;
+    std::condition_variable wake_cv_;
 };
 
 } // namespace lemon
diff --git a/src/cpp/include/lemon/global_vram_monitor.h b/src/cpp/include/lemon/global_vram_monitor.h
index 6cea8bf66..8ad40b9f9 100644
--- a/src/cpp/include/lemon/global_vram_monitor.h
+++ b/src/cpp/include/lemon/global_vram_monitor.h
@@ -1,6 +1,7 @@
 #pragma once
 
 #include <atomic>
+#include <condition_variable>
 #include <thread>
 #include <functional>
 #include <mutex>
@@ -42,6 +43,9 @@ private:
     std::atomic<bool> running_;
     int poll_interval_ms_;
     std::thread monitor_thread_;
+    // stop() wakes the loop, so a shutdown does not wait out the interval.
+    std::mutex wake_mutex_;
+    std::condition_variable wake_cv_;
 
     std::mutex callback_mutex_;
     VramPressureCallback pressure_callback_;
diff --git a/src/cpp/server/eviction_engine.cpp b/src/cpp/server/eviction_engine.cpp
index ff4d611bc..3a4e764ab 100644
--- a/src/cpp/server/eviction_engine.cpp
+++ b/src/cpp/server/eviction_engine.cpp
@@ -29,7 +29,11 @@ void EvictionEngine::start(int interval_ms) {
 }
 
 void EvictionEngine::stop() {
-    running_ = false;
+    {
+        std::lock_guard<std::mutex> lock(wake_mutex_);
+        running_ = false;
+    }
+    wake_cv_.notify_all();
     if (engine_thread_.joinable()) {
         engine_thread_.join();
     }
@@ -52,7 +56,8 @@ void EvictionEngine::evaluation_loop() {
     while (running_) {
         // Also perform regular time-based idle checks
         evaluate_servers(-1.0);
-        std::this_thread::sleep_for(std::chrono::milliseconds(interval_ms_));
+        std::unique_lock<std::mutex> lock(wake_mutex_);
+        wake_cv_.wait_for(lock, std::chrono::milliseconds(interval_ms_), [this] { return !running_; });
     }
 }
 
diff --git a/src/cpp/server/global_vram_monitor.cpp b/src/cpp/server/global_vram_monitor.cpp
index 7cb8d8778..c87422148 100644
--- a/src/cpp/server/global_vram_monitor.cpp
+++ b/src/cpp/server/global_vram_monitor.cpp
@@ -21,7 +21,11 @@ void GlobalVramMonitor::start(int poll_interval_ms) {
 }
 
 void GlobalVramMonitor::stop() {
-    running_ = false;
+    {
+        std::lock_guard<std::mutex> lock(wake_mutex_);
+        running_ = false;
+    }
+    wake_cv_.notify_all();
     if (monitor_thread_.joinable()) {
         monitor_thread_.join();
     }
@@ -54,7 +58,8 @@ void GlobalVramMonitor::monitor_loop() {
             }
         }
 
-        std::this_thread::sleep_for(std::chrono::milliseconds(poll_interval_ms_));
+        std::unique_lock<std::mutex> lock(wake_mutex_);
+        wake_cv_.wait_for(lock, std::chrono::milliseconds(poll_interval_ms_), [this] { return !running_; });
     }
 }
 
