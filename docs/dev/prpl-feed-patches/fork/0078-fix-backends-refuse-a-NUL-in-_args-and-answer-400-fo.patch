From da473d8c14a2792cd33f11ac32243f5d4d1da3cb Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sun, 1 Nov 2026 01:07:54 -0400
Subject: [PATCH 078/102] fix(backends): refuse a NUL in *_args, and answer 400
 for refused *_args

validate_custom_args compared whole std::string tokens, but execvp reads each
argument only up to its first NUL, so "--host\0x 0.0.0.0" passed the reserved
check and reached the engine as --host 0.0.0.0. Any *_args value containing a
NUL is now refused.

A refused *_args load threw std::invalid_argument, which skipped the nuclear
retry but still answered 500 model_load_error. It now answers 400
invalid_backend_args.

Assisted-by: claude:opus-5.5
---
 src/cpp/include/lemon/server/model_loader.h |  1 +
 src/cpp/include/lemon/utils/custom_args.h   |  6 ++++++
 src/cpp/server/services/model_loader.cpp    | 20 ++++++++++++++++++--
 test/cpp/test_engine_reserved_args.cpp      |  4 ++++
 test/server_image_classify.py               | 16 +++++++++++++++-
 5 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/src/cpp/include/lemon/server/model_loader.h b/src/cpp/include/lemon/server/model_loader.h
index 05eb92918..93b1eee60 100644
--- a/src/cpp/include/lemon/server/model_loader.h
+++ b/src/cpp/include/lemon/server/model_loader.h
@@ -46,6 +46,7 @@ public:
     static const RouteError kModelNotFound;
     static const RouteError kRouterResidencyConflict;
     static const RouteError kSlotsPinned;
+    static const RouteError kInvalidBackendArgs;
     static const RouteError kModelLoadError;
     static std::vector<RouteError> errors();
     static const RouteError& load_error(const std::string& error_code);
diff --git a/src/cpp/include/lemon/utils/custom_args.h b/src/cpp/include/lemon/utils/custom_args.h
index d555aa513..ec7cb736e 100644
--- a/src/cpp/include/lemon/utils/custom_args.h
+++ b/src/cpp/include/lemon/utils/custom_args.h
@@ -112,6 +112,12 @@ inline CustomArgsMap build_custom_args_map(const std::vector<std::string>& token
 }
 
 inline std::string validate_custom_args(const std::string& custom_args_str, const std::set<std::string>& reserved_flags) {
+    // execvp reads each argument up to its first NUL, so "--host\0x" would
+    // pass the comparison below and still reach the engine as --host.
+    if (custom_args_str.find('\0') != std::string::npos) {
+        return "Arguments must not contain a NUL character.";
+    }
+
     std::vector<std::string> custom_args = parse_custom_args(custom_args_str);
 
     for (const auto& arg : custom_args) {
diff --git a/src/cpp/server/services/model_loader.cpp b/src/cpp/server/services/model_loader.cpp
index b5c3f3cf5..75ad15dde 100644
--- a/src/cpp/server/services/model_loader.cpp
+++ b/src/cpp/server/services/model_loader.cpp
@@ -200,6 +200,18 @@ json ModelLoader::model_error(const std::string& requested_model,
         return error_response;
     }
 
+    // The backends' validate_custom_args refusals: a caller's *_args, not the server, is at fault.
+    if (exception_msg.rfind("Invalid custom ", 0) == 0) {
+        error_response["error"] = {
+            {"message", "Failed to load model '" + requested_model + "': " + exception_msg},
+            {"type", "invalid_request_error"},
+            {"param", "model"},
+            {"code", kInvalidBackendArgs.code},
+            {"requested_model", requested_model}
+        };
+        return error_response;
+    }
+
     std::string message = "Failed to load model '" + requested_model + "': " + exception_msg;
     error_response["error"] = {
         {"message", message},
@@ -224,6 +236,10 @@ const RouteError ModelLoader::kSlotsPinned{
     409, "slots_pinned_error",
     "Every loaded model of the requested model's type is pinned, so none can be unloaded to make "
     "room"};
+const RouteError ModelLoader::kInvalidBackendArgs{
+    400, "invalid_backend_args",
+    "The model's backend arguments (`*_args`) set a flag Lemonade manages, such as the engine's "
+    "port or bind address"};
 const RouteError ModelLoader::kModelLoadError{
     500, "model_load_error",
     "Loading the requested model fails for another reason, such as a failed download or a backend "
@@ -231,12 +247,12 @@ const RouteError ModelLoader::kModelLoadError{
 
 std::vector<RouteError> ModelLoader::errors() {
     return {kModelNotSupported, kModelNotFound, kRouterResidencyConflict, kSlotsPinned,
-            kModelLoadError};
+            kInvalidBackendArgs, kModelLoadError};
 }
 
 const RouteError& ModelLoader::load_error(const std::string& error_code) {
     for (const RouteError* error : {&kModelNotSupported, &kRouterResidencyConflict,
-                                    &kSlotsPinned, &kModelLoadError}) {
+                                    &kSlotsPinned, &kInvalidBackendArgs, &kModelLoadError}) {
         if (error->code == error_code) {
             return *error;
         }
diff --git a/test/cpp/test_engine_reserved_args.cpp b/test/cpp/test_engine_reserved_args.cpp
index d326bc8e0..435000015 100644
--- a/test/cpp/test_engine_reserved_args.cpp
+++ b/test/cpp/test_engine_reserved_args.cpp
@@ -32,6 +32,10 @@ void check_engine(const std::string& name, const std::set<std::string>& reserved
                name + " rejects " + flag);
         expect(!lemon::utils::validate_custom_args(std::string(flag) + "=x", reserved).empty(),
                name + " rejects " + flag + "=");
+        // The engine's argv ends this token at the NUL, leaving the bare flag.
+        const std::string nul_spliced = std::string(flag) + std::string(1, '\0') + "y x";
+        expect(!lemon::utils::validate_custom_args(nul_spliced, reserved).empty(),
+               name + " rejects " + flag + " followed by a NUL");
     }
     expect(!lemon::utils::validate_custom_args("--threads 2 --host 0.0.0.0", reserved).empty(),
            name + " rejects --host after an allowed flag");
diff --git a/test/server_image_classify.py b/test/server_image_classify.py
index 3b1e8a62a..76cda431a 100644
--- a/test/server_image_classify.py
+++ b/test/server_image_classify.py
@@ -517,11 +517,25 @@ class ImageClassifyTests(ServerTestBase):
         try:
             for args in ("--host 0.0.0.0", "--host=0.0.0.0", "--weight-cache /tmp/x"):
                 response = load_model(MODEL, tflite_args=args)
-                self.assertNotEqual(response.status_code, 200, args)
+                self.assertEqual(response.status_code, 400, args)
+                self.assertEqual(
+                    response.json()["error"]["code"], "invalid_backend_args", args
+                )
                 self.assertIn("managed by Lemonade", response.text, args)
         finally:
             load_model(MODEL, tflite_args="")
 
+    def test_507b2_load_refuses_a_nul_spliced_flag(self):
+        # The engine's argv ends the first token at the NUL, leaving --host.
+        self._require_model()
+        unload_model(MODEL)
+        try:
+            response = load_model(MODEL, tflite_args="--host\x00x 0.0.0.0")
+            self.assertEqual(response.status_code, 400, response.text[:500])
+            self.assertIn("NUL", response.text)
+        finally:
+            load_model(MODEL, tflite_args="")
+
     def test_507c_weight_cache_symlink_not_used(self):
         # The engine would write its weight cache through the link, which in an
         # HF snapshot points into the shared blob store.
