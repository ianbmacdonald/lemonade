From a9c62a04e7589d23dfbe2aa1d55b45f31b4194cd Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Tue, 29 Sep 2026 17:48:39 -0400
Subject: [PATCH 31/92] fix(routing): report route_to and trace candidates by
 public model name

The route decision (x_lemonade_route and /routing/validate) emitted
route_to as the internal component id the policy parser resolved, e.g.
user.Gemma3-1B-IT-LiteRT, while /v1/models lists the same model under its
public name (Gemma3-1B-IT-LiteRT), so a client joining the two missed.
Serialize route_to and trace labels (router candidates) through
ModelManager::get_public_model_name, the mapping /v1/models uses.
Dispatch still uses the internal id.

Assisted-by: claude:opus-5.5
---
 src/cpp/include/lemon/server/router_dispatch.h    | 6 ++++++
 src/cpp/server/core/api_route.cpp                 | 6 ++++--
 src/cpp/server/route_decision_response.cpp        | 9 +++++++--
 src/cpp/server/routes/router/router_dispatch.cpp  | 7 +++++++
 src/cpp/server/routes/router/routing_validate.cpp | 8 +++++---
 5 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/src/cpp/include/lemon/server/router_dispatch.h b/src/cpp/include/lemon/server/router_dispatch.h
index ac59731f9..a18b22f82 100644
--- a/src/cpp/include/lemon/server/router_dispatch.h
+++ b/src/cpp/include/lemon/server/router_dispatch.h
@@ -6,6 +6,7 @@
 
 #include <nlohmann/json.hpp>
 
+#include "lemon/route_decision_response.h"
 #include "lemon/routing_policy.h"
 
 namespace lemon {
@@ -18,8 +19,13 @@ struct RouterDispatchResult {
     std::string requested_model;
     std::string selected_model;
     Decision decision;
+    // Dispatch uses the engine's internal ids; responses report public names, the ones
+    // /v1/models lists, so a client can join route_to against it.
+    ModelNameMapper public_model_name;
 };
 
+ModelNameMapper public_model_name_mapper(ModelManager& model_manager);
+
 // The decision the registered policy of collection.router `info` makes for body. Dispatch
 // and the classify-only /routing/validate share it so the two cannot disagree. It has no
 // dispatch side effects, though routing helper models may load. std::nullopt when the
diff --git a/src/cpp/server/core/api_route.cpp b/src/cpp/server/core/api_route.cpp
index 6295a04dc..32d08019a 100644
--- a/src/cpp/server/core/api_route.cpp
+++ b/src/cpp/server/core/api_route.cpp
@@ -615,7 +615,8 @@ void ApiRoute::stream_response(RouteRequest& req, httplib::Response& res, Stream
     }
 
     json route_decision_json = req.route_decision
-        ? route_decision_to_json(req.route_decision->decision)
+        ? route_decision_to_json(req.route_decision->decision,
+                                 req.route_decision->public_model_name)
         : json(nullptr);
     std::string body = req.body.is_null() ? req.http.body : req.body.dump();
     std::function<bool()> is_closed = req.http.is_connection_closed;
@@ -767,7 +768,8 @@ void attach_route_decision(json& response, httplib::Response& res,
     if (!decision) {
         return;
     }
-    response["x_lemonade_route"] = route_decision_to_json(decision->decision);
+    response["x_lemonade_route"] =
+        route_decision_to_json(decision->decision, decision->public_model_name);
     attach_route_header(res, decision->decision);
 }
 
diff --git a/src/cpp/server/route_decision_response.cpp b/src/cpp/server/route_decision_response.cpp
