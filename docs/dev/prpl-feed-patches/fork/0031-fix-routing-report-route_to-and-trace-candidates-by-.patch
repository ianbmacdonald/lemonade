         {"default_used", decision.default_used},
         {"outputs", decision.outputs.is_object() ? decision.outputs : json::object()},
@@ -68,7 +71,9 @@ json route_decision_to_json(const Decision& decision,
                 trace_entry["score"] = *entry.score;
