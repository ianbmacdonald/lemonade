From 7b2694ff5ac87ce40817df25dbf9e5c63f888cec Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sun, 1 Nov 2026 01:08:19 -0400
Subject: [PATCH 080/107] fix(beacon): mark the broadcast socket close-on-exec

The listener's sockets were marked in the previous round; NetworkBeacon's
broadcast socket was not, so engine processes inherited it.

Assisted-by: claude:opus-5.5
---
 src/cpp/server/utils/network_beacon.cpp |  4 ++++
 test/cpp/test_connection_guard.cpp      | 28 +++++++++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/src/cpp/server/utils/network_beacon.cpp b/src/cpp/server/utils/network_beacon.cpp
index 105eb33bf..9acf0ca43 100644
--- a/src/cpp/server/utils/network_beacon.cpp
+++ b/src/cpp/server/utils/network_beacon.cpp
@@ -20,6 +20,7 @@
     #define INVALID_SOCKET_NB INVALID_SOCKET
 #else
     #include <arpa/inet.h>
+    #include <fcntl.h>
     #include <ifaddrs.h>
     #include <net/if.h>
     #include <netinet/in.h>
@@ -66,6 +67,9 @@ void NetworkBeacon::createSocket() {
     if (_socket == INVALID_SOCKET_NB) {
         throw std::runtime_error("Could not create socket");
     }
+#ifndef _WIN32
+    fcntl(_socket, F_SETFD, FD_CLOEXEC);
+#endif
 }
 
 std::string NetworkBeacon::getLocalHostname() {
diff --git a/test/cpp/test_connection_guard.cpp b/test/cpp/test_connection_guard.cpp
index 916776cd3..a884116fe 100644
--- a/test/cpp/test_connection_guard.cpp
+++ b/test/cpp/test_connection_guard.cpp
@@ -19,6 +19,7 @@
 
 #include <lemon/connection_guard.h>
 #include <lemon/upgradable_http_server.h>
+#include <lemon/utils/network_beacon.h>
 
 #include "test_config_helpers.h"
 
@@ -234,6 +235,32 @@ static void test_watch_socket_is_close_on_exec() {
     ::close(fds[0]);
     ::close(fds[1]);
 }
+
+static int open_descriptors() {
+    int n = 0;
+    for (int fd = 0; fd < 1024; ++fd) {
+        if (::fcntl(fd, F_GETFD) >= 0) {
+            ++n;
+        }
+    }
+    return n;
+}
+
+static void test_beacon_socket_is_close_on_exec() {
+    const int open_before = open_descriptors();
+    const int inheritable_before = inheritable_descriptors();
+    NetworkBeacon beacon;
+    // Port 9 is discard; the beacon sends one datagram per interval.
+    beacon.startBroadcasting(9, 9, 1);
+    const auto t0 = std::chrono::steady_clock::now();
+    while (open_descriptors() == open_before && std::chrono::steady_clock::now() - t0 < 3s) {
+        std::this_thread::sleep_for(10ms);
+    }
+    check(open_descriptors() > open_before, "the beacon opened its broadcast socket");
+    check(inheritable_descriptors() == inheritable_before,
+          "the beacon's broadcast socket is not inherited by child processes");
+    beacon.stopBroadcasting();
+}
 #endif
 
 // A peer that connects and sends nothing, or stops mid-headers, must not hold
@@ -280,6 +307,7 @@ int main() {
     test_peek_is_bounded();
 #ifdef __linux__
     test_watch_socket_is_close_on_exec();
+    test_beacon_socket_is_close_on_exec();
 #endif
 #endif
     return report_results("connection guard");
-- 
